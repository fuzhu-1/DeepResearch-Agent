# =============================================================================
# DeepResearch-Agent Environment Configuration
# =============================================================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env
# =============================================================================

# ---------------------------------------------------------------------------
# LLM API Keys (choose at least one)
# ---------------------------------------------------------------------------
# OpenAI API Key (supports GPT-4o, GPT-4-turbo, etc.)
# Required if provider is "openai"
OPENAI_API_KEY=

# OpenAI-compatible base URL (e.g. DeepSeek: https://api.deepseek.com)
OPENAI_BASE_URL=

# Embedding API (OpenAI-compatible, e.g. OpenRouter: https://openrouter.ai/api/v1)
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=
EMBEDDING_MODEL=

# Anthropic API Key (supports Claude 3.5 Sonnet, Claude 3 Opus, etc.)
# Required if provider is "anthropic"
ANTHROPIC_API_KEY=

# DashScope API Key (for Alibaba Cloud embedding models)
# Optional — only needed for DashScope embeddings
DASHSCOPE_API_KEY=

# ---------------------------------------------------------------------------
# Model Selection — specify models for different agents
# ---------------------------------------------------------------------------
LLM_MODEL_PLANNER=gpt-4o
LLM_MODEL_RESEARCHER=gpt-4o
LLM_MODEL_WRITER=gpt-4o
LLM_MODEL_REVIEWER=gpt-4o

# ---------------------------------------------------------------------------
# Search API
# ---------------------------------------------------------------------------
# Search provider: "tavily" (Tavily is paid; DuckDuckGo fallback is free and automatic)
SEARCH_API_PROVIDER=tavily

# Tavily Search API Key (https://tavily.com)
# Optional — search falls back to DuckDuckGo (free) + GitHub if not set
TAVILY_API_KEY=

# GitHub Token (for GitHub code search, optional)
# Creates a personal token at https://github.com/settings/tokens (no scopes needed)
# Without this, GitHub search still works but with a lower rate limit (60 req/hr)
GITHUB_TOKEN=

# ---------------------------------------------------------------------------
# Storage
# ---------------------------------------------------------------------------
# Redis connection URL (for caching and session management; leave empty for in-memory)
REDIS_URL=redis://localhost:6379/0

# ChromaDB vector database persistence path
CHROMA_DB_PATH=./data/chroma_db

# ---------------------------------------------------------------------------
# Server
# ---------------------------------------------------------------------------
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=info

# ---------------------------------------------------------------------------
# Hybrid Search & Reranking (RAG)
# ---------------------------------------------------------------------------
# Hybrid retrieval = dense embeddings + BM25 keyword fusion
HYBRID_SEARCH_ENABLED=False
VECTOR_WEIGHT=0.7
BM25_WEIGHT=0.3

# Reranker: "openrouter" (free: nvidia/llama-nemotron-rerank-vl-1b-v2:free)
# or "dashscope" (gte-rerank). OpenRouter free rerank models require no credits.
RERANKER_ENABLED=False
RERANKER_PROVIDER=dashscope
RERANKER_API_KEY=
RERANKER_API_BASE=https://openrouter.ai/api/v1/rerank
RERANKER_MODEL=nvidia/llama-nemotron-rerank-vl-1b-v2:free

# ---------------------------------------------------------------------------
# Workspace
# ---------------------------------------------------------------------------
WORKSPACE_ROOT=./data/workspaces
UPLOAD_MAX_FILES=10
UPLOAD_MAX_BYTES=20971520
UPLOAD_ALLOWED_EXTS=.pdf,.md,.txt,.csv,.json,.docx
